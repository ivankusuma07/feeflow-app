# Public config for apps/web. Every value here ships to the browser: no secrets.
# See docs/placeholders.md for the status of each value.

NEXT_PUBLIC_CHAIN_ID=4663
# Empty = the verified public Robinhood Chain RPC (recent state only). Set a paid provider in production.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=

# Leave blank until deployed: the UI shows "Not deployed yet" and never sample data.
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_SINK_IMPLEMENTATION_ADDRESS=
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_PRIVY_APP_ID=

# "indexer" (default) or "mock". mock is dev-only; a production build refuses it.
NEXT_PUBLIC_DATA_SOURCE=indexer

NEXT_PUBLIC_DEX_SWAP_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_TOS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_DOMAIN=
NEXT_PUBLIC_AUDIT_STATUS=
NEXT_PUBLIC_KEEPER_STALE_AFTER=3600
