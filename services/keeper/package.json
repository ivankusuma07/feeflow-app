{
  "name": "@feeflow/keeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:anvil": "vitest run --config vitest.anvil.config.ts"
  },
  "dependencies": {
    "@feeflow/abi": "workspace:*",
    "@feeflow/config": "workspace:*",
    "@feeflow/sdk": "workspace:*",
    "viem": "^2.58.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1",
    "@feeflow/anvil-kit": "workspace:*"
  }
}
