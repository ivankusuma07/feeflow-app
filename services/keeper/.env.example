# services/keeper — copy to .env.local (gitignored).
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# RPC_URL_FALLBACK=
CONTRACT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
# Hot wallet holding gas only. Production: the host's secret store, never git.
# Local Anvil: account 2's public test key works.
KEEPER_KEY=
INDEXER_URL=http://127.0.0.1:42069
# Base units of the pair asset (USDG has 6 decimals, ETH 18).
COLLECT_THRESHOLD_USDG=10000000
COLLECT_THRESHOLD_ETH=10000000000000000
# Other ERC-20 pairs; unset = not collected by the keeper.
# COLLECT_THRESHOLD_OTHER=
LOOP_INTERVAL_SECONDS=300
GAS_BUDGET_WEI_PER_RUN=5000000000000000
MAX_RELEASE_BATCHES=50
KEEPER_MIN_BALANCE_WEI=5000000000000000
WITHDRAW_FEES_EVERY_DAYS=7
HEALTH_PORT=8788
