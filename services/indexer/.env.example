# services/indexer — copy to .env.local (gitignored). Ponder loads .env.local itself.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# RPC_URL_FALLBACK=
# Unset → embedded PGlite in .ponder/ (development only). Production: the VPS Postgres.
# DATABASE_URL=postgres://feeflow:...@127.0.0.1:5432/feeflow
CONTRACT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
CONTRACT_DEPLOY_BLOCK=0
# Ponder writes into this Postgres schema; use a new one per deploy (blue/green reindex).
DATABASE_SCHEMA=feeflow
CONFIRMATIONS=12
SNAPSHOT_INTERVAL_BLOCKS=1200
CORS_ORIGIN=http://localhost:3000
# X_API_BEARER=

KEEPER_HEALTH_URL=http://127.0.0.1:8788/health
KEEPER_STALE_AFTER=3600
