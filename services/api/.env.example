# services/api: attestation service + X API proxy (brief §Stage 4). Copy to .env.local for dev.
# Secrets (PRIVY_APP_SECRET, X_API_BEARER, attester key) live only in the host's secret store.
NODE_ENV=development
PORT=8787
CHAIN_ID=31337
CONTRACT_ADDRESS=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: without it /x/users and register attestations answer 503.
X_API_BEARER=
# Development only (refused when NODE_ENV=production). Anvil account 1 is the DeployLocal attester.
ATTESTER_KEY=
# Production: KMS key id (signer not implemented yet; boot fails if set).
ATTESTER_KMS_KEY_ID=
# Comma-separated allowed origins.
CORS_ORIGIN=http://localhost:3000
# 1 behind Caddy, so rate limits use the real client IP.
TRUSTED_PROXIES=0
ATTESTATION_TTL_SECONDS=300
